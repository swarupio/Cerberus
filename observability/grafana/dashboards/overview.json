{
  "uid": "cerberus-overview",
  "title": "Cerberus Overview",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "cerberus"
  ],
  "panels": [
    {
      "id": 5,
      "title": "User-service circuit breaker",
      "description": "Opens after 3 consecutive failures; waits 30 seconds before a half-open probe. A successful probe closes the circuit.",
      "type": "state-timeline",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "cerberus-prometheus" },
      "targets": [{
        "refId": "A",
        "expr": "sum(gateway_circuit_breaker_state{downstream=\"user-service\",state=\"open\"}) + 2 * sum(gateway_circuit_breaker_state{downstream=\"user-service\",state=\"half_open\"})",
        "legendFormat": "user-service",
        "range": true,
        "instant": false,
        "datasource": { "type": "prometheus", "uid": "cerberus-prometheus" }
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [{
            "type": "value",
            "options": {
              "0": { "text": "Closed", "color": "green" },
              "1": { "text": "Open", "color": "red" },
              "2": { "text": "Half-open", "color": "yellow" }
            }
          }]
        },
        "overrides": []
      },
      "options": { "mergeValues": true, "showValue": "auto", "alignValue": "center", "rowHeight": 0.9 }
    },
    {
      "id": 1,
      "title": "Service availability",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Request rate (excluding metrics scrapes)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_requests_total{route!=\"/metrics\"}[1m])) or on (job) (sum by (job) (up) * 0)",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "HTTP error rate (4xx + 5xx)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_requests_total{route!=\"/metrics\",status_code=~\"4..|5..\"}[1m])) or on (job) (sum by (job) (up) * 0)",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Mean request latency (excluding metrics scrapes)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "cerberus-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (job) (rate(http_request_duration_seconds_sum{route!=\"/metrics\"}[1m]))) / clamp_min(sum by (job) (rate(http_request_duration_seconds_count{route!=\"/metrics\"}[1m])), 1e-9)) or on (job) (sum by (job) (up) * 0)",
          "legendFormat": "{{job}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "cerberus-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
